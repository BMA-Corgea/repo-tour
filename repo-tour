#!/usr/bin/env bash
#
# repo-tour — top-level control script.
#
# Point it at a repository and it walks you through it: digest the tree, then open a
# guided tour of what it found.
#
#   ./repo-tour serve  [--port N] [--no-watch]  THE APP: load repos, refresh to see changes (default)
#   ./repo-tour tour   [path] [--flags]   one-off: digest a repo and open a static tour page
#   ./repo-tour digest [path] [--flags]   digest a repo and open the plain browsable view
#   ./repo-tour open   [path|id]          re-open a saved tour WITHOUT re-digesting
#   ./repo-tour tours                     the library: every tour you have made, pick one
#   ./repo-tour doctor                    check node, deps and parser grammars
#   ./repo-tour build                     compile src/ to dist/
#   ./repo-tour test                      run the acceptance suite
#
# `path` defaults to the current directory. With no path and an interactive terminal,
# `tour` and `digest` ask which repo you mean, so a double-click is a complete flow.
#
# Port 7788 — recorded in ../PROJECT_PORTS.md. Override with --port. NOT 7777: see the
# `7777 is a trap` section there.
#
# There is no daemon and nothing to stop. A digest writes a `.repo-tour/` cache INTO the
# repo it scanned — that cache is what makes a re-digest cost only the diff. Pass
# `--no-write` to leave the target untouched, and `--view <file>` to put the page
# somewhere else.

set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ── colours (fall back to plain when not a tty) ─────────────────────────────
if [ -t 1 ]; then
  C_G=$'\e[32m'; C_R=$'\e[31m'; C_Y=$'\e[33m'; C_DIM=$'\e[2m'; C_B=$'\e[1m'; C_0=$'\e[0m'
else
  C_G=; C_R=; C_Y=; C_DIM=; C_B=; C_0=
fi

_say()  { printf '%s\n' "$*"; }
_ok()   { printf '%s✓%s %s\n' "$C_G" "$C_0" "$*"; }
_warn() { printf '%s!%s %s\n' "$C_Y" "$C_0" "$*"; }
_die()  { printf '%s✗%s %s\n' "$C_R" "$C_0" "$*" >&2; exit 1; }

_hyperlink() { # _hyperlink <url> <text>
  if [ -t 1 ]; then printf '\033]8;;%s\033\\%s\033]8;;\033\\' "$1" "$2"
  else printf '%s' "$2"; fi
}

_opener() {
  if command -v xdg-open >/dev/null 2>&1; then echo xdg-open
  elif command -v open >/dev/null 2>&1; then echo open
  else echo ""; fi
}

# ── preflight ───────────────────────────────────────────────────────────────
_need_node() {
  command -v node >/dev/null 2>&1 || _die "node is not installed. repo-tour needs Node 20 or newer."
  local major
  major="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null)"
  if [ -z "$major" ] || [ "$major" -lt 20 ]; then
    _die "node $(node -v 2>/dev/null) is too old — repo-tour needs Node 20 or newer."
  fi
}

_need_deps() {
  if [ ! -d "$ROOT/node_modules/web-tree-sitter" ] || [ ! -d "$ROOT/node_modules/tree-sitter-wasms" ]; then
    _warn "dependencies are not installed yet — running npm install (one time, ~10s)"
    ( cd "$ROOT" && npm install --no-audit --no-fund ) || _die "npm install failed."
    _ok "dependencies installed"
  fi
}

# Resolve the repo to work on: explicit arg, else ask, else here.
_resolve_target() {
  local given="${1:-}"
  if [ -n "$given" ]; then printf '%s' "$given"; return; fi
  if [ -t 0 ] && [ -t 1 ]; then
    printf '%sWhich repository should I read?%s %s(Enter for the current directory)%s\n' \
      "$C_B" "$C_0" "$C_DIM" "$C_0" >&2
    local reply
    read -rp "  path: " reply || true
    # strip surrounding quotes a file-manager drag-and-drop leaves behind
    reply="${reply%\"}"; reply="${reply#\"}"
    reply="${reply%\'}"; reply="${reply#\'}"
    printf '%s' "${reply:-.}"
  else
    printf '%s' "."
  fi
}

_view_path() { # _view_path <target> — where the CLI drops the page by default
  printf '%s/.repo-tour/view.html' "$(cd "$1" 2>/dev/null && pwd)"
}

_open_view() { # _open_view <file>
  local file="$1"
  [ -f "$file" ] || return 1
  local op; op="$(_opener)"
  printf '\n  %s  ' "$(_hyperlink "file://$file" "open the tour")"
  printf '%s%s%s\n' "$C_DIM" "$file" "$C_0"
  if [ -n "$op" ] && [ -t 1 ]; then
    "$op" "$file" >/dev/null 2>&1 &
    printf '  %sopening in your browser…%s\n' "$C_DIM" "$C_0"
  fi
}

# ── commands ────────────────────────────────────────────────────────────────
cmd_run() { # cmd_run <tour|digest> [path] [extra flags...]
  local mode="$1"; shift
  _need_node
  _need_deps

  local target=""
  local -a flags=()
  for arg in "$@"; do
    case "$arg" in
      -*) flags+=("$arg") ;;
      *)  [ -z "$target" ] && target="$arg" || flags+=("$arg") ;;
    esac
  done

  target="$(_resolve_target "$target")"
  [ -d "$target" ] || _die "not a directory: $target"

  printf '\n%srepo-tour%s %s%s%s\n' "$C_B" "$C_0" "$C_DIM" "$(cd "$target" && pwd)" "$C_0"
  [ "$mode" = "tour" ] && printf '%sreading the whole tree, then building a tour of it. This is not fast, and is not meant to be.%s\n' "$C_DIM" "$C_0"

  ( cd "$ROOT" && npx tsx src/cli.ts "$mode" "$target" "${flags[@]+"${flags[@]}"}" )
  local rc=$?
  [ $rc -eq 0 ] || return $rc

  # --view <file> / --no-write move or suppress the page; only auto-open the default spot.
  local suppressed=0
  for f in "${flags[@]+"${flags[@]}"}"; do
    case "$f" in --view|--no-write) suppressed=1 ;; esac
  done
  [ $suppressed -eq 0 ] && _open_view "$(_view_path "$target")"
  return 0
}

cmd_open() {
  _need_node; _need_deps
  local file
  # An id (or id prefix) names a saved tour; anything else is a path.
  if [ -n "${1:-}" ] && [ ! -d "${1:-}" ]; then
    file="$( cd "$ROOT" && npx tsx src/cli.ts open "$1" 2>/dev/null )" || true
  else
    local target; target="$(_resolve_target "${1:-}")"
    file="$( cd "$target" && cd "$ROOT" && npx tsx src/cli.ts open "$(cd "$target" && pwd)" 2>/dev/null )" || true
    [ -f "${file:-}" ] || file="$(_view_path "$target")"
  fi
  if ! _open_view "${file:-}"; then
    _die "no saved tour for that — run './repo-tour tour <path>' first, or './repo-tour tours' to see what you have."
  fi
}

cmd_serve() {
  _need_node; _need_deps
  local port=7788
  local -a passthru=()
  local watch=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --port) port="${2:-7788}"; passthru+=("$1" "$2"); shift 2 ;;
      --no-watch) watch=0; shift ;;
      *) passthru+=("$1"); shift ;;
    esac
  done

  local url="http://127.0.0.1:$port"
  local op; op="$(_opener)"
  if [ -n "$op" ] && [ -t 1 ]; then
    ( sleep 2; "$op" "$url" >/dev/null 2>&1 ) &
  fi

  # `tsx watch` restarts the server when repo-tour's own source changes.
  #
  # Without it, the running process holds the code it started with: pulling an update and
  # then wondering why the app looks the same is the obvious outcome, and "restart the whole
  # app" is not an answer anybody should have to reach for. The served pages poll
  # /api/version and reload themselves when the boot id changes, so an update lands without
  # a restart AND without a refresh. --no-watch opts out.
  if [ "$watch" -eq 1 ]; then
    printf '%swatching src/ — the app restarts and your open tabs reload when the code changes%s\n' "$C_DIM" "$C_0"
    ( cd "$ROOT" && npx tsx watch --clear-screen=false src/cli.ts serve "${passthru[@]+"${passthru[@]}"}" )
  else
    ( cd "$ROOT" && npx tsx src/cli.ts serve "${passthru[@]+"${passthru[@]}"}" )
  fi
}

cmd_tours() {
  _need_node; _need_deps
  ( cd "$ROOT" && npx tsx src/cli.ts list )
  local lib; lib="$( cd "$ROOT" && npx tsx src/cli.ts library )"
  _open_view "$lib" || true
}

cmd_doctor() {
  local bad=0
  printf '\n%srepo-tour doctor%s\n\n' "$C_B" "$C_0"

  if command -v node >/dev/null 2>&1; then
    local major; major="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null)"
    if [ -n "$major" ] && [ "$major" -ge 20 ]; then _ok "node $(node -v)"
    else _warn "node $(node -v) — needs 20 or newer"; bad=1; fi
  else
    _warn "node not found"; bad=1
  fi

  command -v git >/dev/null 2>&1 && _ok "git $(git --version | awk '{print $3}')" \
    || { _warn "git not found — churn ranking needs it"; bad=1; }

  if [ -d "$ROOT/node_modules/web-tree-sitter" ]; then _ok "web-tree-sitter installed"
  else _warn "dependencies not installed — run: npm install"; bad=1; fi

  local g="$ROOT/node_modules/tree-sitter-wasms/out"
  local missing=""
  for lang in python javascript typescript tsx; do
    [ -f "$g/tree-sitter-$lang.wasm" ] || missing="$missing $lang"
  done
  if [ -z "$missing" ]; then _ok "parser grammars: python, javascript, typescript, tsx"
  else _warn "missing grammars:$missing"; bad=1; fi

  printf '\n'
  if [ $bad -eq 0 ]; then _ok "ready — try: ./start.sh"; else _warn "fix the above, then re-run ./repo-tour doctor"; fi
  return $bad
}

cmd_build() { _need_node; _need_deps; ( cd "$ROOT" && npx tsc -p tsconfig.json ) && _ok "compiled to dist/"; }
cmd_test()  { _need_node; _need_deps; ( cd "$ROOT" && npx vitest run ); }

usage() {
  sed -n '3,27p' "$ROOT/repo-tour" | sed 's/^# \{0,1\}//'
}

# ── dispatch ────────────────────────────────────────────────────────────────
cmd="${1:-serve}"
case "$cmd" in
  serve|app)       shift || true; cmd_serve "$@" ;;
  tour)            shift || true; cmd_run tour "$@" ;;
  digest)          shift || true; cmd_run digest "$@" ;;
  open)            shift || true; cmd_open "$@" ;;
  tours|library)   cmd_tours ;;
  doctor)          cmd_doctor ;;
  build)           cmd_build ;;
  test)            cmd_test ;;
  -h|--help|help)  usage ;;
  -*)              cmd_serve "$@" ;;             # ./repo-tour --port 8080
  *)               cmd_run tour "$@" ;;          # ./repo-tour ~/some/repo
esac
